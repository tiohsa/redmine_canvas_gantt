<% content_for :header_tags do %>
  <%= javascript_tag do %>
    window.RedmineCanvasGantt = {
      projectId: <%= @project.id %>,
      projectPath: '<%= project_path(@project) %>',
      issueListPath: '<%= project_issues_path(@project) %>',
      newIssuePath: '<%= new_project_issue_path(@project) %>',
      canvasGanttPath: '<%= project_canvas_gantt_path(@project) %>',
      apiBase: '<%= project_path(@project) %>/canvas_gantt',
      redmineBase: '<%= Redmine::Utils.relative_url_root %>',
      authToken: '<%= form_authenticity_token %>',
      i18n: <%= @i18n.to_json.html_safe %>,
      settings: <%= (@settings || {}).to_json.html_safe %>,
      nonWorkingWeekDays: <%= (@non_working_week_days || [0, 6]).to_json.html_safe %>,
      language: '<%= @language %>',
      dateFormat: '<%= @date_format %>',
      yearMonthFormat: '<%= @year_month_format %>'
    };

  <% end %>
  <!-- In development with Vite dev server enabled, we use the Vite dev server. Otherwise, we use the manifest. -->
  <% use_vite_dev = Rails.env.development? && ENV['CANVAS_GANTT_USE_VITE_DEV_SERVER'] == '1' %>
  <% if use_vite_dev %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= javascript_include_tag "http://localhost:5173/src/main.tsx", type: "module" %>
  <% else %>
    <!-- Production assets will be injected here via manifest -->
    <% vite_stylesheet_path("src/main.tsx")&.each do |css_path| %>
      <%= stylesheet_link_tag css_path %>
    <% end %>
    <%= javascript_include_tag vite_javascript_path("src/main.tsx"), type: "module" %>
  <% end %>
<% end %>

<div id="redmine-canvas-gantt-root" style="width: 100%; min-height: 400px; height: 70vh; border: 1px solid #ddd;">
  <!-- React App Mount Point -->
  Loading Canvas Gantt...
</div>

<%= javascript_tag do %>
  (() => {
    const root = document.getElementById('redmine-canvas-gantt-root');
    if (!root) return;

    const updateHeight = () => {
      const viewportHeight = window.visualViewport?.height || window.innerHeight;
      const top = root.getBoundingClientRect().top;
      const footer = document.getElementById('footer');
      const footerHeight = footer?.offsetHeight || 0;
      const available = Math.max(400, Math.floor(viewportHeight - top - footerHeight - 16));
      root.style.height = `${available}px`;
    };

    updateHeight();
    window.addEventListener('resize', updateHeight, { passive: true });
    window.visualViewport?.addEventListener('resize', updateHeight, { passive: true });

    if (window.ResizeObserver) {
      const observer = new ResizeObserver(updateHeight);
      const header = document.getElementById('header');
      const mainMenu = document.getElementById('main-menu');
      if (header) observer.observe(header);
      if (mainMenu) observer.observe(mainMenu);
    }
  })();
<% end %>
